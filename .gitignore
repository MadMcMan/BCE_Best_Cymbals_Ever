# Dependencies
# NOTE: `deps/*`, not `deps/` — git never descends into an excluded directory,
# so a `deps/` rule makes any `!deps/...` re-include below it a silent no-op.
# Matching children individually is what lets the vendored trees be pulled back in.
deps/*
!deps/sst-effects/
!deps/sst-effects/**
!deps/sst-basic-blocks/
!deps/sst-basic-blocks/**
!deps/sst-filters/
!deps/sst-filters/**
!deps/sst-waveshapers/
!deps/sst-waveshapers/**
!deps/fmt/
!deps/fmt/**
# CMake includes headers and sources from this tree; it is a build input, not a
# scratch checkout. Keep it tracked so a fresh clone can configure.
!deps/vendored-fx/
!deps/vendored-fx/**
# (the cymbals-ui kit is re-included at the very bottom of this file — see the
#  "Vendored cymbals-ui kit" block; gitignore's last match wins, so the
#  negation has to come after broad rules like `skills/`.)
# Project artifacts and logs
logs/
*.log
step*_build.*
build_output.*
test_output.*
*_test_*.exe
tmp_*.*
artifacts/debug/
artifacts/review/
.local/
.plans/
node_modules/
proxy.js
build-lvgl/
# Any other scratch build dir (build-core, build-gauntlet, build-keybed, ...):
# each of these was an ad-hoc configure dir, not a shipped artifact.
build-*/
package-lock.json
package.json
tokenizer/
.venv/
git_show_head.cpp
build-mac/
build-linux/
build-windows/
build-plugin/
build-mac-mingwtest/
build-linux-mingwtest/
artifacts/
.agents/
orchestrator/
plans/
tools/
# Keep script workspace clutter ignored by default; release/installer entry
# points used by GitHub Actions stay tracked. Local packaging helpers are not.
scripts/*
!scripts/installer_win/
!scripts/installer_win/cymbals64.iss
!scripts/installer_linux/
!scripts/installer_linux/make_deb.sh
!scripts/installer_linux/make_rpm.sh
!scripts/installer_mac/
!scripts/installer_mac/make_installer.sh
skills/
instructions/
